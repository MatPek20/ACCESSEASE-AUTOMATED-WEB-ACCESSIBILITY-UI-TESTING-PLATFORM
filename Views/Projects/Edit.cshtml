@model AccessEase12.ViewModels.ProjectFormViewModel

@{
    ViewData["Title"] = "Edit Project";
    Layout = "_Layout";

    var projectInitial = !string.IsNullOrWhiteSpace(Model.Name)
        ? Model.Name.Trim()[0].ToString().ToUpper()
        : "P";
}

<div class="project-page-grid">
    <div class="app-card project-summary-card">
        <div class="project-summary-top">
            <div class="project-avatar-circle">
                @projectInitial
            </div>

            <div>
                <h2 class="project-name">@Model.Name</h2>
                <div class="project-status-badge">Project Settings</div>
            </div>
        </div>

        <div class="project-summary-info">
            <div class="project-info-item">
                <span class="project-info-label">Default URL</span>
                <span class="project-info-value">
                    @(string.IsNullOrWhiteSpace(Model.DefaultUrl) ? "Not set" : Model.DefaultUrl)
                </span>
            </div>

            <div class="project-info-item">
                <span class="project-info-label">Description</span>
                <span class="project-info-value">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description added yet." : Model.Description)
                </span>
            </div>
        </div>

        <div class="project-summary-note">
            Manage project details, description, and default website URL for future scans.
        </div>
    </div>

    <div class="app-card project-form-card">
        <div class="section-header compact-page-header">
            <div>
                <p class="section-subtitle mb-0">
                    Update project details, description, and default URL for future scans.
                </p>
            </div>
        </div>

        <form asp-action="Edit" method="post" class="project-edit-form-grid">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="All" class="app-alert danger validation-summary"></div>

            <div class="form-block full">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-input" placeholder="Enter project name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-block full">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-input form-textarea" placeholder="Enter project description"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="form-block full">
                <label asp-for="DefaultUrl" class="form-label fw-semibold"></label>
                <input asp-for="DefaultUrl" class="form-input" placeholder="Enter default website URL" />
                <span asp-validation-for="DefaultUrl" class="text-danger small"></span>
            </div>

            <div class="project-action-row">
                <button type="submit" class="primary-btn">Update Project</button>
                <a asp-controller="Projects" asp-action="Index" class="secondary-btn project-btn-inline">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}