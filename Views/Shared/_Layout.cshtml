@using System.Security.Claims
@{
    var fullName = User.Identity != null && User.Identity.IsAuthenticated
        ? User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User"
        : "Guest";

    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AccessEase</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell-body">
    <div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop"></div>

    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="app-brand app-brand-logo-wrap">
                <img src="~/images/logoAE.png" alt="AccessEase Logo" class="app-brand-logo" />
            </div>

            <nav class="app-nav">
                @if (User.IsInRole("Developer"))
                {
                    <a class="app-nav-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")"
                       asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 nav-icon"></i>
                        <span>Dashboard</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Home" && currentAction == "Scan" ? "active" : "")"
                       asp-controller="Home" asp-action="Scan">
                        <i class="bi bi-search nav-icon"></i>
                        <span>Run Scan</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Home" && currentAction == "History" ? "active" : "")"
                       asp-controller="Home" asp-action="History">
                        <i class="bi bi-clock-history nav-icon"></i>
                        <span>Scan Results</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Home" && currentAction == "Reports" ? "active" : "")"
                       asp-controller="Home" asp-action="Reports">
                        <i class="bi bi-file-earmark-text nav-icon"></i>
                        <span>Reports</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Home" && currentAction == "CompareScans" ? "active" : "")"
                       asp-controller="Home" asp-action="CompareScans">
                        <i class="bi bi-columns-gap nav-icon"></i>
                        <span>Compare Scans</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                       asp-controller="Account" asp-action="Profile">
                        <i class="bi bi-person-circle nav-icon"></i>
                        <span>Profile</span>
                    </a>
                }

                @if (User.IsInRole("ProjectManager"))
                {
                    <a class="app-nav-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")"
                       asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 nav-icon"></i>
                        <span>Dashboard</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Projects" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Projects" asp-action="Index">
                        <i class="bi bi-folder2-open nav-icon"></i>
                        <span>Projects</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Remediation" ? "active" : "")"
                       asp-controller="Remediation" asp-action="Index">
                        <i class="bi bi-wrench-adjustable-circle nav-icon"></i>
                        <span>Remediation</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Baseline" ? "active" : "")"
                       asp-controller="Baseline" asp-action="Index">
                        <i class="bi bi-bookmark-check nav-icon"></i>
                        <span>Baseline</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Home" && currentAction == "Reports" ? "active" : "")"
                       asp-controller="Home" asp-action="Reports">
                        <i class="bi bi-file-earmark-text nav-icon"></i>
                        <span>Reports</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Home" && currentAction == "CompareScans" ? "active" : "")"
                       asp-controller="Home" asp-action="CompareScans">
                        <i class="bi bi-columns-gap nav-icon"></i>
                        <span>Compare Scans</span>
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a class="app-nav-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")"
                       asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 nav-icon"></i>
                        <span>Dashboard</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Admin" && currentAction == "UserManagement" ? "active" : "")"
                       asp-controller="Admin" asp-action="UserManagement">
                        <i class="bi bi-people nav-icon"></i>
                        <span>User Management</span>
                    </a>

                    <a class="app-nav-link @(currentController == "Admin" && currentAction == "LoginLogs" ? "active" : "")"
                       asp-controller="Admin" asp-action="LoginLogs">
                        <i class="bi bi-shield-lock nav-icon"></i>
                        <span>Login Logs</span>
                    </a>
                }
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggleBtn" type="button" aria-label="Toggle menu">
                        ☰
                    </button>

                    <div>
                        <div class="app-page-kicker">@role</div>
                        <div class="app-page-title">@ViewData["Title"]</div>
                    </div>
                </div>

                <div class="app-topbar-right">
                    <button class="theme-btn" id="themeToggle" type="button" title="Change Theme">
                        <span id="themeIcon">☾</span>
                    </button>

                    <div class="app-user-box app-user-profile-box">
                        <img src="~/images/default-avatar.png" alt="Profile" class="app-user-avatar" />
                        <div class="app-user-name">Hi, @fullName</div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        (function () {
            const html = document.documentElement;
            const toggleBtn = document.getElementById("themeToggle");
            const themeIcon = document.getElementById("themeIcon");
            const storageKey = "accessease-theme";

            function applyTheme(theme) {
                html.setAttribute("data-theme", theme);
                if (themeIcon) {
                    themeIcon.textContent = theme === "dark" ? "☀" : "☾";
                }
            }

            const savedTheme = localStorage.getItem(storageKey);
            if (savedTheme === "dark" || savedTheme === "light") {
                applyTheme(savedTheme);
            } else {
                applyTheme("light");
            }

            if (toggleBtn) {
                toggleBtn.addEventListener("click", function () {
                    const currentTheme = html.getAttribute("data-theme");
                    const nextTheme = currentTheme === "dark" ? "light" : "dark";
                    applyTheme(nextTheme);
                    localStorage.setItem(storageKey, nextTheme);
                });
            }

            const sidebar = document.getElementById("appSidebar");
            const sidebarToggleBtn = document.getElementById("sidebarToggleBtn");
            const backdrop = document.getElementById("mobileSidebarBackdrop");

            function openSidebar() {
                sidebar?.classList.add("mobile-open");
                backdrop?.classList.add("show");
                document.body.classList.add("sidebar-open");
            }

            function closeSidebar() {
                sidebar?.classList.remove("mobile-open");
                backdrop?.classList.remove("show");
                document.body.classList.remove("sidebar-open");
            }

            if (sidebarToggleBtn) {
                sidebarToggleBtn.addEventListener("click", function () {
                    if (sidebar?.classList.contains("mobile-open")) {
                        closeSidebar();
                    } else {
                        openSidebar();
                    }
                });
            }

            if (backdrop) {
                backdrop.addEventListener("click", closeSidebar);
            }

            window.addEventListener("resize", function () {
                if (window.innerWidth > 1100) {
                    closeSidebar();
                }
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>