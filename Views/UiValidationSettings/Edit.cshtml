@model AccessEase12.ViewModels.ProjectUiValidationSettingViewModel

@{
    ViewData["Title"] = "Edit UI Validation Settings";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-2">UI Validation Settings</h2>
            <p class="text-muted mb-4">Project: <strong>@Model.ProjectName</strong></p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ProjectId" type="hidden" />
                <input asp-for="ProjectName" type="hidden" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="RequireHeader" class="form-check-input" />
                            <label asp-for="RequireHeader" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="RequireMain" class="form-check-input" />
                            <label asp-for="RequireMain" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="RequireFooter" class="form-check-input" />
                            <label asp-for="RequireFooter" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="RequireNav" class="form-check-input" />
                            <label asp-for="RequireNav" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="RequirePageTitle" class="form-check-input" />
                            <label asp-for="RequirePageTitle" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="RequireSingleH1" class="form-check-input" />
                            <label asp-for="RequireSingleH1" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="CheckUnlabeledInputs" class="form-check-input" />
                            <label asp-for="CheckUnlabeledInputs" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="CheckDuplicateIds" class="form-check-input" />
                            <label asp-for="CheckDuplicateIds" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="CheckHorizontalOverflow" class="form-check-input" />
                            <label asp-for="CheckHorizontalOverflow" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check border rounded p-3">
                            <input asp-for="CheckTinyClickTargets" class="form-check-input" />
                            <label asp-for="CheckTinyClickTargets" class="form-check-label ms-2"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MinClickTargetSize" class="form-label fw-semibold"></label>
                        <input asp-for="MinClickTargetSize" class="form-control" />
                        <span asp-validation-for="MinClickTargetSize" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save Settings</button>
                    <a asp-controller="UiValidationSettings" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}