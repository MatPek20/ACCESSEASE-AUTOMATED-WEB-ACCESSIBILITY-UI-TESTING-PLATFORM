@model List<AccessEase.Models.ScanRecord>

@{
    ViewData["Title"] = "Scan History";
    Layout = "_Layout";
}

<div class="app-card">
    <div class="section-header">
        <div>
            <p class="section-subtitle">
                Review your previous scans, issue counts, and open detailed reports.
            </p>
        </div>

        @if (Model != null && Model.Any())
        {
            <form asp-action="ClearHistory" method="post" onsubmit="return confirm('Clear all your scan history?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="danger-btn">
                    Clear History
                </button>
            </form>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-alert success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state-box">
            <h4>No scan history yet</h4>
            <p>Your completed scans will appear here once you start testing a project.</p>
            <a asp-controller="Home" asp-action="Scan" class="primary-btn mt-2">
                Run Your First Scan
            </a>
        </div>
    }
    else
    {
        <div class="history-table-wrap">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Scan ID</th>
                        <th>Target URL</th>
                        <th>Scan Time</th>
                        <th>Issue Count</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.ScanTime))
                    {
                        <tr>
                            <td>
                                <span class="history-id">#@item.Id</span>
                            </td>
                            <td>
                                <div class="history-url">@item.Url</div>
                            </td>
                            <td>
                                <div class="history-time">@item.ScanTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                            </td>
                            <td>
                                <span class="history-issue-badge @(item.IssueCount > 0 ? "has-issues" : "clean-issues")">
                                    @item.IssueCount issue(s)
                                </span>
                            </td>
                            <td>
                                <div class="history-actions">
                                    <a asp-action="HistoryDetails" asp-route-id="@item.Id" class="mini-doc-btn">
                                        View Details
                                    </a>

                                    <a asp-action="ExportCsv" asp-route-id="@item.Id" class="secondary-btn small-btn">
                                        Export CSV
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>