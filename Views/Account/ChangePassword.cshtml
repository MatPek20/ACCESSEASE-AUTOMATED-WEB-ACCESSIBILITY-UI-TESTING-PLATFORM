@model AccessEase12.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="app-card form-page-card">
    <div class="section-header">
        <div>
            <h2 class="section-title">Change Password</h2>
            <p class="section-subtitle">
                Update your password to keep your account secure.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-alert success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="app-alert danger"></div>

        <div class="project-form-grid">
            <div class="form-block full">
                <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                <input asp-for="CurrentPassword" type="password" class="form-input" placeholder="Enter current password" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="form-block full">
                <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                <input asp-for="NewPassword" type="password" class="form-input" placeholder="Enter new password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-block full">
                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-input" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="action-row left-actions">
            <button type="submit" class="primary-btn">Update Password</button>
            <a asp-controller="Account" asp-action="Profile" class="secondary-btn">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}